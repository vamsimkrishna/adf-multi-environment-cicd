{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-vk-cicd-dev-01"
		},
		"LS_ADLS_CICD_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stvkadfcicddev01.dfs.core.windows.net/"
		},
		"LS_AZSQL_CICD_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-vk-cicd-dev-01.database.windows.net"
		},
		"LS_AZSQL_CICD_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-adf-cicd-dev"
		},
		"default_properties_gp_environment_value": {
			"type": "string",
			"defaultValue": "DEV"
		},
		"default_properties_gp_container_value": {
			"type": "string",
			"defaultValue": "adf-data"
		},
		"default_properties_gp_landing_folder_value": {
			"type": "string",
			"defaultValue": "landing/customers"
		},
		"default_properties_gp_target_schema_value": {
			"type": "string",
			"defaultValue": "dbo"
		},
		"default_properties_gp_target_table_value": {
			"type": "string",
			"defaultValue": "customer_staging"
		},
		"default_properties_gp_customer_file_name_value": {
			"type": "string",
			"defaultValue": "customers_dev.csv"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-vk-cicd-dev-01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"default_properties_gp_environment_value": {
						"value": "[parameters('default_properties_gp_environment_value')]"
					},
					"default_properties_gp_container_value": {
						"value": "[parameters('default_properties_gp_container_value')]"
					},
					"default_properties_gp_landing_folder_value": {
						"value": "[parameters('default_properties_gp_landing_folder_value')]"
					},
					"default_properties_gp_target_schema_value": {
						"value": "[parameters('default_properties_gp_target_schema_value')]"
					},
					"default_properties_gp_target_table_value": {
						"value": "[parameters('default_properties_gp_target_table_value')]"
					},
					"default_properties_gp_customer_file_name_value": {
						"value": "[parameters('default_properties_gp_customer_file_name_value')]"
					},
					"LS_ADLS_CICD_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_CICD_properties_typeProperties_url')]"
					},
					"LS_AZSQL_CICD_properties_typeProperties_server": {
						"value": "[parameters('LS_AZSQL_CICD_properties_typeProperties_server')]"
					},
					"LS_AZSQL_CICD_properties_typeProperties_database": {
						"value": "[parameters('LS_AZSQL_CICD_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}